{
	"name": "n8n-nodes-juzpost",
	"version": "0.1.0",
	"description": "n8n community node for JuzPost: schedule and publish social media posts to YouTube, TikTok, Instagram, Facebook, X, LinkedIn, Pinterest, Threads, Bluesky, Tumblr and WordPress from one calendar.",
	"license": "MIT",
	"homepage": "https://www.juzpost.com",
	"keywords": [
		"n8n-community-node-package",
		"juzpost",
		"social-media",
		"social-media-scheduler",
		"scheduler",
		"tiktok",
		"youtube",
		"instagram",
		"linkedin",
		"bluesky",
		"threads"
	],
	"author": {
		"name": "JuzPost",
		"email": "support@juzpost.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/juzpost/juzpost-integrations.git",
		"directory": "n8n"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/JuzPostApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/JuzPost/JuzPost.node.js",
			"dist/nodes/JuzPost/JuzPostTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
