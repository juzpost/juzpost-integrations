{
    "url": "/accounts",
    "method": "GET",
    "headers": {
        "Authorization": "Bearer {{connection.apiKey}}"
    },
    "qs": {
        "limit": 100,
        "sort": "platform",
        "order": "asc"
    },
    "response": {
        "limit": 500,
        "iterate": "{{body.data}}",
        "output": {
            "label": "{{item.platform}} · {{item.username}}{{if(item.isActive, '', ' (needs reconnect)')}}",
            "value": "{{item.id}}"
        }
    },
    "pagination": {
        "condition": "{{body.pagination.hasMore}}",
        "qs": {
            "cursor": "{{body.pagination.nextCursor}}"
        }
    }
}
