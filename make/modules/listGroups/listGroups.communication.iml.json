{
    "url": "/groups",
    "method": "GET",
    "headers": {
        "Authorization": "Bearer {{connection.apiKey}}"
    },
    "qs": {
        "name": "{{parameters.name}}",
        "limit": 100
    },
    "response": {
        "iterate": "{{body.data}}",
        "output": "{{item}}",
        "limit": "{{parameters.limit}}"
    },
    "pagination": {
        "condition": "{{body.pagination.hasMore}}",
        "qs": {
            "cursor": "{{body.pagination.nextCursor}}"
        }
    }
}
